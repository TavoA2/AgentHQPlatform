# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=agent_hq
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=agent_hq
POSTGRES_PORT=5432

# --- Backend (read by agent_hq.config, prefix AGENT_HQ_) ---
AGENT_HQ_ENVIRONMENT=local
AGENT_HQ_BRAND_NAME="Veltrix Labs"
AGENT_HQ_LOG_LEVEL=INFO
# For running the API on the host (uv run ...). Compose overrides this for containers.
AGENT_HQ_DATABASE_URL=postgresql+psycopg://agent_hq:change-me-local-only@127.0.0.1:5432/agent_hq
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_HQ_SESSION_SECRET=

# --- Model providers (ADR-0005, ADR-0010) ---
# Profiles map to "provider:model". Without these lines the deterministic mock provider is
# used and no paid API is called. Model names live only here, never in code.
# AGENT_HQ_MODEL_PROFILE_REASONING=openai:gpt-6.1-sol
# AGENT_HQ_MODEL_PROFILE_FAST=openai:gpt-6-luna
# Optional per-agent override: AGENT_HQ_MODEL_OVERRIDES={"devops":"openai:gpt-6.1-sol"}
# USD per 1M tokens [input, output], used only to estimate cost (no budget is enforced).
# AGENT_HQ_MODEL_PRICING={"gpt-6.1-sol":[2.0,10.0],"gpt-6-luna":[0.1,0.5]}
# OpenAI API key (platform.openai.com, with billing). Set a monthly limit in the dashboard.
# OPENAI_API_KEY=
# Loop guards (not budgets): model calls per specialist run, graph steps per run.
# AGENT_HQ_AGENT_MAX_STEPS=12
# AGENT_HQ_GRAPH_RECURSION_LIMIT=50

# --- GitHub read-only access (ADR-0008) ---
# Fine-grained PAT, selected repositories only, Contents: read + Metadata: read
# (+ Actions: read). Repositories are then authorized per project in the UI.
# AGENT_HQ_GITHUB_TOKEN=

# --- GitHub App for draft pull requests (ADR-0013, docs/guides/github-app.md) ---
# AGENT_HQ_GITHUB_APP_ID=
# Path inside the containers; put the key file at ./secrets/github-app.pem
# AGENT_HQ_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem

# --- Notifications (docs/guides/notifications.md) ---
AGENT_HQ_PUBLIC_URL=http://localhost:3000
# AGENT_HQ_SLACK_WEBHOOK_URL=
# AGENT_HQ_TELEGRAM_BOT_TOKEN=
# AGENT_HQ_TELEGRAM_CHAT_ID=

# --- Sandbox runner (ADR-0011) ---
# Shared secret between the worker and the sandbox service (min 32 chars). Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_HQ_SANDBOX_TOKEN=
# AGENT_HQ_SANDBOX_TIMEOUT_SECONDS=120
# AGENT_HQ_MAX_PARALLEL_STEPS=2

# --- Approvals and worker ---
# AGENT_HQ_APPROVAL_TTL_HOURS=24
# AGENT_HQ_WORKER_CONCURRENCY=2

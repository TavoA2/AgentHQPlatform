# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=agent_hq
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=agent_hq
POSTGRES_PORT=5432

# --- Backend (read by agent_hq.config, prefix AGENT_HQ_) ---
AGENT_HQ_ENVIRONMENT=local
AGENT_HQ_BRAND_NAME="Veltrix Labs"
AGENT_HQ_LOG_LEVEL=INFO
# For running the API on the host (uv run ...). Compose overrides this for containers.
AGENT_HQ_DATABASE_URL=postgresql+psycopg://agent_hq:change-me-local-only@localhost:5432/agent_hq
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_HQ_SESSION_SECRET=

# --- Sprint 1: model providers (ADR-0005) ---
# Model names live in configuration, mapped from profiles; keys are read only by adapters.
# AGENT_HQ_MODEL_PROFILE_REASONING=openai:<model-name>
# AGENT_HQ_MODEL_PROFILE_FAST=openai:<model-name>
# AGENT_HQ_TASK_TOKEN_BUDGET=200000
# OPENAI_API_KEY=

# --- Sprint 1: GitHub read-only access (ADR-0008) ---
# Fine-grained PAT, selected repositories only, Contents: read + Metadata: read.
# AGENT_HQ_GITHUB_TOKEN=

# --- Observability (optional, off by default) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=agent-hq-api

# Production configuration. Copy to the repository root as `.env.prod` ON THE SERVER
# (root-owned, chmod 600). Never commit it. See docs/runbooks/first-deployment.md.

# --- Hostnames ---
# No domain yet? Use sslip.io with the Elastic IP (Terraform prints these).
HQ_DOMAIN=hq.3-91-10-20.sslip.io
DEMO_DOMAIN=demo.3-91-10-20.sslip.io
# Email for Let's Encrypt expiry notices.
CADDY_GLOBAL_OPTIONS="email you@example.com"
AGENT_HQ_BRAND_NAME="Veltrix Labs"

# --- Private database ---
POSTGRES_USER=agent_hq
# Generate: openssl rand -base64 36
POSTGRES_PASSWORD=
POSTGRES_DB=agent_hq

# --- Secrets (generate each: openssl rand -base64 48) ---
# The session secret also encrypts 2FA secrets: rotating it requires re-enrolling 2FA.
AGENT_HQ_SESSION_SECRET=
AGENT_HQ_SANDBOX_TOKEN=

# --- Integrations (optional) ---
# OPENAI_API_KEY=
# AGENT_HQ_MODEL_PROFILE_REASONING=openai:gpt-6.1-sol
# AGENT_HQ_MODEL_PROFILE_FAST=openai:gpt-6-luna
# Chat with Dixon uses the fast profile by default (reasoning | fast), or an override:
# AGENT_HQ_CHAT_MODEL_PROFILE=fast
# AGENT_HQ_MODEL_OVERRIDES={"cio_chat":"openai:gpt-6-luna"}
# AGENT_HQ_GITHUB_TOKEN=
# AGENT_HQ_GITHUB_APP_ID=
# AGENT_HQ_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# AGENT_HQ_SLACK_WEBHOOK_URL=
# AGENT_HQ_TELEGRAM_BOT_TOKEN=
# AGENT_HQ_TELEGRAM_CHAT_ID=
